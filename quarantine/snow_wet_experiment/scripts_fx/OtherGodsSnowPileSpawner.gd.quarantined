class_name OtherGodsSnowPileSpawner
extends Node3D

@export var board_anchor: Node3D = null
@export var snow_pile_textures: Array[Texture2D] = []
@export var snow_edge_textures: Array[Texture2D] = []
@export var board_size := Vector2(20.2, 6.8)
@export var decal_height := 5.2
@export_range(0.0, 1.0, 0.01) var accumulation: float = 0.0:
	set(value):
		accumulation = clampf(value, 0.0, 1.0)
		_refresh_piles()

var _piles: Array[Decal] = []
var _rng := RandomNumberGenerator.new()

func _ready() -> void:
	_rng.seed = 44257
	_refresh_piles()

func set_accumulation(value: float) -> void:
	accumulation = value

func _refresh_piles() -> void:
	for decal in _piles:
		if is_instance_valid(decal):
			decal.queue_free()
	_piles.clear()

	var anchor := board_anchor if board_anchor != null else self
	var pile_count := int(lerpf(2.0, 30.0, accumulation))
	for i in range(pile_count):
		var tex := _pick_texture(snow_pile_textures)
		_add_decal(anchor, tex, _random_board_pos(anchor), _rng.randf_range(1.0, 3.1), _rng.randf() * TAU, 0.18 + accumulation * 0.58)

	var edge_count := int(lerpf(2.0, 14.0, accumulation))
	for i in range(edge_count):
		var tex := _pick_texture(snow_edge_textures)
		_add_decal(anchor, tex, _random_edge_pos(anchor), _rng.randf_range(2.0, 5.7), _rng.randf() * TAU, 0.26 + accumulation * 0.68)

func _pick_texture(textures: Array[Texture2D]) -> Texture2D:
	if textures.is_empty():
		return null
	return textures[_rng.randi_range(0, textures.size() - 1)]

func _random_board_pos(anchor: Node3D) -> Vector3:
	return anchor.global_position + Vector3(
		_rng.randf_range(-board_size.x * 0.44, board_size.x * 0.44),
		decal_height,
		_rng.randf_range(-board_size.y * 0.42, board_size.y * 0.42)
	)

func _random_edge_pos(anchor: Node3D) -> Vector3:
	var side := _rng.randi_range(0, 3)
	var x := _rng.randf_range(-board_size.x * 0.52, board_size.x * 0.52)
	var z := _rng.randf_range(-board_size.y * 0.52, board_size.y * 0.52)
	match side:
		0:
			z = -board_size.y * 0.50
		1:
			z = board_size.y * 0.50
		2:
			x = -board_size.x * 0.50
		_:
			x = board_size.x * 0.50
	return anchor.global_position + Vector3(x, decal_height, z)

func _add_decal(anchor: Node3D, tex: Texture2D, pos: Vector3, footprint: float, yaw: float, alpha: float) -> void:
	if tex == null:
		return
	var decal := Decal.new()
	decal.name = "SnowPileDecal"
	decal.texture_albedo = tex
	decal.size = Vector3(footprint, decal_height, footprint)
	decal.global_position = pos
	decal.rotation_degrees.x = -90.0
	decal.rotation.y = yaw
	decal.modulate = Color(0.84, 0.94, 1.0, alpha)
	add_child(decal)
	_piles.append(decal)
