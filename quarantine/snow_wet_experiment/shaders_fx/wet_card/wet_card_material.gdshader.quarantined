shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back;

uniform sampler2D base_albedo : source_color;
uniform sampler2D wetness_control;
uniform sampler2D wet_normal : hint_normal;
uniform sampler2D wet_roughness;

uniform float wet_strength : hint_range(0.0, 1.0) = 1.0;
uniform float puddle_gloss_boost : hint_range(0.0, 1.0) = 0.65;
uniform float normal_strength : hint_range(0.0, 2.0) = 0.65;
uniform vec3 wet_tint : source_color = vec3(0.72, 0.76, 0.80);

void fragment() {
    vec4 control = texture(wetness_control, UV);

    float damp = control.r;
    float puddle = control.g;
    float flow = control.b;
    float feather = control.a;

    float wet = clamp((damp * 0.55 + puddle * 0.90 + flow * 0.38) * feather * wet_strength, 0.0, 1.0);

    vec3 base = texture(base_albedo, UV).rgb;
    ALBEDO = mix(base, base * wet_tint, wet);

    float rough_map = texture(wet_roughness, UV).r;
    ROUGHNESS = clamp(mix(0.82, rough_map, wet), 0.035, 0.92);
    ROUGHNESS = min(ROUGHNESS, mix(ROUGHNESS, 0.035, puddle * feather * wet_strength * puddle_gloss_boost));

    vec3 wet_n = texture(wet_normal, UV).rgb;
    NORMAL_MAP = mix(vec3(0.5, 0.5, 1.0), wet_n, wet * normal_strength);
    NORMAL_MAP_DEPTH = 1.0;

    SPECULAR = mix(0.35, 0.82, wet);
}
