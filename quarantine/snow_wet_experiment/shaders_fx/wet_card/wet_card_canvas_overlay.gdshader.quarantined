shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D wetness_control : filter_linear;
uniform sampler2D wet_normal : hint_normal, filter_linear;
uniform sampler2D wet_roughness : filter_linear;
uniform sampler2D droplet_atlas : source_color, filter_linear;

uniform float wet_strength : hint_range(0.0, 1.0) = 0.65;
uniform float gloss_strength : hint_range(0.0, 1.0) = 0.72;
uniform float droplet_strength : hint_range(0.0, 1.0) = 0.44;
uniform float flow_speed : hint_range(0.0, 2.0) = 0.24;
uniform vec2 wind_direction = vec2(-1.0, 0.25);
uniform vec4 damp_tint : source_color = vec4(0.10, 0.18, 0.22, 1.0);
uniform vec4 highlight_tint : source_color = vec4(0.84, 0.95, 1.0, 1.0);
uniform vec2 atlas_grid = vec2(4.0, 2.0);

void fragment() {
	vec2 uv = UV;
	vec4 control = texture(wetness_control, uv);
	float damp = control.r;
	float puddle = control.g;
	float flow = control.b;
	float feather = control.a;
	float wet = clamp((damp * 0.48 + puddle * 0.88 + flow * 0.34) * feather * wet_strength, 0.0, 1.0);

	vec3 n = texture(wet_normal, uv).rgb * 2.0 - 1.0;
	float rough = texture(wet_roughness, uv).r;
	vec2 wind = normalize(wind_direction + vec2(0.001, 0.001));
	float moving_flow = texture(wetness_control, uv + vec2(wind.x * 0.015, 0.055) * TIME * flow_speed).b;
	float ripple = sin((uv.y + moving_flow * 0.16 + TIME * flow_speed * 0.18) * 44.0 + n.x * 5.0) * 0.5 + 0.5;
	float gloss = smoothstep(0.28, 0.88, puddle + flow * 0.35 + ripple * 0.22) * (1.0 - rough) * gloss_strength * wet;

	float row = floor(fract(TIME * 0.13 + uv.x * 0.17) * atlas_grid.y);
	float col = floor(fract(TIME * 0.09 + uv.x * 0.31 + uv.y * 0.13) * atlas_grid.x);
	vec2 cell = vec2(col, row);
	vec2 cell_uv = fract(uv + vec2(wind.x * 0.028, TIME * flow_speed));
	vec2 atlas_uv = (cell + cell_uv) / atlas_grid;
	vec4 drop = texture(droplet_atlas, atlas_uv);
	float droplet_alpha = drop.a * droplet_strength * wet_strength * feather * smoothstep(0.20, 0.78, flow + puddle);

	vec3 color = damp_tint.rgb * (wet * 0.46);
	color += highlight_tint.rgb * (gloss * 0.42 + droplet_alpha * 0.36);
	float alpha = clamp(wet * 0.46 + gloss * 0.24 + droplet_alpha * 0.70, 0.0, 0.82);
	COLOR = vec4(color, alpha);
}
