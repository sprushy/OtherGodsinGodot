+func _pull_turn_tower_for_smoke(card_test, distance: float, touch: bool = false) -> bool:
+	var tower = card_test._end_turn_tower
+	if not tower.is_available():
+		return false
+	await get_tree().process_frame
+	var start: Vector2 = tower.get_global_transform_with_canvas() * tower.get_grip_position()
+	var finish: Vector2 = start + Vector2(0.0, distance)
+	if touch:
+		var press := InputEventScreenTouch.new()
+		press.index = 0
+		press.position = start
+		press.pressed = true
+		tower.get_viewport().push_input(press, true)
+	else:
+		var press := InputEventMouseButton.new()
+		press.position = start
+		press.button_index = MOUSE_BUTTON_LEFT
+		press.button_mask = MOUSE_BUTTON_MASK_LEFT
+		press.pressed = true
+		tower.get_viewport().push_input(press, true)
+	await get_tree().process_frame
+	if not tower.is_pulling():
+		_write_smoke_trace("tower_press_missed start=%s rect=%s available=%s local_hit=%s viewport=%s hovered=%s" % [str(start), str(tower.get_global_rect()), str(tower.is_available()), str(tower._has_point(tower.get_grip_position())), str(tower.get_viewport().get_visible_rect()), str(tower.get_viewport().gui_get_hovered_control())])
+		return false
+	if touch:
+		var drag := InputEventScreenDrag.new()
+		drag.index = 0
+		drag.position = finish
+		drag.relative = finish - start
+		tower.get_viewport().push_input(drag, true)
+	else:
+		var drag := InputEventMouseMotion.new()
+		drag.position = finish
+		drag.relative = finish - start
+		drag.button_mask = MOUSE_BUTTON_MASK_LEFT
+		tower.get_viewport().push_input(drag, true)
+	await get_tree().process_frame
+	if touch:
+		var release := InputEventScreenTouch.new()
+		release.index = 0
+		release.position = finish
+		tower.get_viewport().push_input(release, true)
+	else:
+		var release := InputEventMouseButton.new()
+		release.position = finish
+		release.button_index = MOUSE_BUTTON_LEFT
+		tower.get_viewport().push_input(release, true)
+	await get_tree().process_frame
+	return not tower.is_pulling()
