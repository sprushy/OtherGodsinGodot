static func rating_for(card_name: String) -> int:
	return int(CARD_FIELD_DELTA_TENTHS.get(str(card_name).strip_edges(), UNRATED_RATING))


static func has_rating(card_name: String) -> bool:
	return CARD_FIELD_DELTA_TENTHS.has(str(card_name).strip_edges())
