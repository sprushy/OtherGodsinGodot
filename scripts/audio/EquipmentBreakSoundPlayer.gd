extends AudioStreamPlayer
class_name EquipmentBreakSoundPlayer

# User-provided sound effect for a creature breaking (destroying) an equipment card.
const SOUND_PATH := "res://audio/equipment_break.ogg"

static var _sound: AudioStream

static func play_sound() -> void:
	if DisplayServer.get_name() == "headless":
		return
	if _sound == null:
		_sound = load(SOUND_PATH) as AudioStream
	var tree := Engine.get_main_loop() as SceneTree
	if tree == null or tree.root == null:
		return
	var player := EquipmentBreakSoundPlayer.new()
	tree.root.add_child(player)
	player.stream = _sound
	player.play()

func _ready() -> void:
	bus = "SFX"
	finished.connect(queue_free)
